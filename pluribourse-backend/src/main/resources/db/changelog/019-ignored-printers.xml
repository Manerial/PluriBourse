<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Story 3.13: printers detected by PrinterBridge but explicitly excluded from the
         discovery picker — never registered in the printers table. -->
    <changeSet id="019-ignored-printers" author="pluribourse">
        <createTable tableName="ignored_printers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="printer_bridge_id" type="VARCHAR(32)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="ignored_at" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
