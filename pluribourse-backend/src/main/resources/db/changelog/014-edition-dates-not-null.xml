<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="014-edition-dates-backfill" author="pluribourse">
        <!-- Backfill pre-existing NULL start_date/end_date before the NOT NULL constraint below,
             using created_at (already NOT NULL) as the least-arbitrary fallback. -->
        <update tableName="editions">
            <column name="start_date" valueComputed="created_at"/>
            <where>start_date IS NULL</where>
        </update>
        <update tableName="editions">
            <column name="end_date" valueComputed="created_at"/>
            <where>end_date IS NULL</where>
        </update>
    </changeSet>

    <changeSet id="014-edition-dates-not-null" author="pluribourse">
        <addNotNullConstraint tableName="editions" columnName="start_date" columnDataType="DATE"/>
        <addNotNullConstraint tableName="editions" columnName="end_date" columnDataType="DATE"/>
    </changeSet>

</databaseChangeLog>
